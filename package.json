{
  "name": "dsh-auto-effort",
  "version": "1.0.0",
  "description": "Per-turn thinking-effort routing that keeps the current model, including Magpie and other third-party providers",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "node scripts/check-publish.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=18.17"
  },
  "author": "dsh-auto-effort contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subeichen1/dsh-auto-effort.git"
  },
  "homepage": "https://github.com/subeichen1/dsh-auto-effort#readme",
  "bugs": {
    "url": "https://github.com/subeichen1/dsh-auto-effort/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "plugin",
    "reasoning-effort",
    "thinking",
    "magpie"
  ],
  "license": "MIT"
}
